{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run check",
  "outputDirectory": "public",
  "regions": ["lhr1"],
  "functions": {
    "api/index.mjs": { "maxDuration": 30, "includeFiles": "public/**" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}

